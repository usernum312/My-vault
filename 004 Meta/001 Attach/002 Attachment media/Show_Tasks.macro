tyle\u003d\u0027color: steelblue\u0027\u003e١٠ دقائق\u003c/strong\u003e قراءة [[003 Books|كتب مفيدة]] \u003c!-- (@2026-06-18 before-maghrib 20m) --\u003e\\n- [ ] \u003cstrong style\u003d\u0027color: steelblue\u0027\u003e٥ دقائق\u003c/strong\u003e سماع [[Quran|القرآن الكريم]]\\n- [ ] \u003cstrong style\u003d\u0027color: steelblue\u0027\u003e١٠ دقائق\u003c/strong\u003e اداء [[Light exercise|رياضة خفيفة]] \u003c!-- (@2026-06-18 after-sunset 50m) --\u003e\\n- [ ] \u003cstrong style\u003d\u0027color: steelblue\u0027\u003eثواني\u003c/strong\u003e لذكر الله عند الاستيقاظ\\n\\n## [[Reward|مكافئة]] مقابل اداء المهام \\n## **(على الأقل مهمة محورية واثنتان أخرى)**);","m_type":5,"supportsInput":false,"supportsOutput":true},{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":true,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"current task","m_stringValue":"١٥ دقيقة أداء رواتب صلاة الظهر","m_type":2,"supportsInput":false,"supportsOutput":true}],"localVarsAlphabetical":true,"m_GUID":-7965410223747375606,"m_actionList":[{"blockNextAction":true,"javascriptEngine":"JetPack JavascriptEngine","scriptText":"var dateObj \u003d new Date();\n\n// جلب السنة\nvar year \u003d dateObj.getFullYear();\n\n// جلب الشهر (نضيف 1 لأن الأشهر تبدأ من 0 في الجافا سكريبت)\nvar month \u003d dateObj.getMonth() + 1;\nif (month \u003c 10) {\n    month \u003d \u00270\u0027 + month;\n}\n\n// جلب اليوم\nvar day \u003d dateObj.getDate();\nif (day \u003c 10) {\n    day \u003d \u00270\u0027 + day;\n}\n\n// دمج العناصر بالصيغة المطلوبة YYYY-MM-DD\nvar formattedDate \u003d year + \u0027-\u0027 + month + \u0027-\u0027 + day;\n\n// تمرير النتيجة إلى ماكرودرويد\nmdOutput(formattedDate);","stringVariableName":"date","disableLogging":false,"m_SIGUID":-7885699517114520288,"m_classType":"JavaScriptAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"filename":"{lv\u003ddate}.md","pathName":"/001 Active Diaries","pathUri":"content://com.android.externalstorage.documents/tree/primary%3AObsidian%2FMy-vault%2F003%20Daily%2F001%20Active%20Diaries","staticFilename":false,"useAllFilesAccess":false,"variableName":"today content","disableLogging":false,"m_SIGUID":-6332634196059400310,"m_classType":"ReadFileAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"javascriptEngine":"JetPack JavascriptEngine","scriptText":"var txt \u003d `[{lv\u003dtoday content}]`;\nvar lines \u003d txt.split(\u0027\\n\u0027);\nvar out \u003d [];\nvar i, line, match, tm, cln;\n\nvar now \u003d new Date();\nvar curMin \u003d (now.getHours() * 60) + now.getMinutes();\n\nfor (i \u003d 0; i \u003c lines.length; i++) {\n    line \u003d lines[i].trim();\n    if (line.indexOf(\u0027- [ ]\u0027) \u003d\u003d\u003d 0) {\n        \n        match \u003d line.match(new RegExp(\u0027\u0027));\n        tm \u003d \"\";\n        if (match \u0026\u0026 match[1]) {\n            var regTime \u003d new RegExp(\u0027@[0-9]{4}-[0-9]{2}-[0-9]{2}\\\\s*\u0027, \u0027g\u0027);\n            tm \u003d \" ⏰ [\" + match[1].replace(regTime, \u0027\u0027).trim() + \"]\";\n        }\n        \n        cln \u003d line.replace(\u0027- [ ]\u0027, \u0027\u0027);\n        cln \u003d cln.replace(new RegExp(\u0027\u0027, \u0027g\u0027), \u0027\u0027);\n        cln \u003d cln.replace(new RegExp(\u0027\u003c\\/?[^\u003e]+(\u003e|$)\u0027, \u0027g\u0027), \u0027\u0027);\n        cln \u003d cln.replace(new RegExp(\u0027\\\\[\\\\[([^\\\\]|]+)\\\\|?([^\\\\]]*)\\\\]\\\\]\u0027, \u0027g\u0027), function(m, p1, p2) { return p2 ? p2 : p1; });\n        cln \u003d cln.replace(new RegExp(\u0027\\\\*\\\\*\u0027, \u0027g\u0027), \u0027\u0027);\n        cln \u003d cln.trim();\n        \n        if (cln.length \u003e 0) {\n            var isValid \u003d true;\n            \n            if (cln.indexOf(\"الظهر\") !\u003d\u003d -1 \u0026\u0026 (curMin \u003c 720 || curMin \u003e 960)) { isValid \u003d false; }\n            if (cln.indexOf(\"الفجر\") !\u003d\u003d -1 \u0026\u0026 (curMin \u003c 180 || curMin \u003e 420)) { isValid \u003d false; }\n            if (cln.indexOf(\"المغرب\") !\u003d\u003d -1 \u0026\u0026 (curMin \u003c 1080 || curMin \u003e 1260)) { isValid \u003d false; }\n            if (cln.indexOf(\"الصباح\") !\u003d\u003d -1 \u0026\u0026 (curMin \u003c 360 || curMin \u003e 780)) { isValid \u003d false; }\n            if (cln.indexOf(\"المساء\") !\u003d\u003d -1 \u0026\u0026 (curMin \u003c 960 || curMin \u003e 1320)) { isValid \u003d false; }\n            \n            if (isValid) {\n                out.push(cln + tm);\n            }\n        }\n    }\n}\n\nif (out.length \u003d\u003d\u003d 0) {\n    out.push(\"كل المهام أنجزت! 🎉\");\n}\n\nmdOutput(out);","stringVarDictionaryKeys":{"keys":[]},"stringVariableName":"undone tasks","disableLogging":false,"m_SIGUID":-6371472052225585381,"m_classType":"JavaScriptAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"booleanDictionaryKeys":{"keys":[]},"dictionaryKeys":[],"dictionaryOrArrayType":-1,"existingManualKeyType":0,"m_booleanInvert":false,"m_darkMode":-1,"m_doubleRandomMax":0.0,"m_doubleRandomMin":0.0,"m_falseLabel":"False","m_intExpression":false,"m_intRandom":false,"m_intRandomMax":0,"m_intRandomMin":0,"m_intValueDecrement":false,"m_intValueIncrement":false,"m_newBooleanValue":false,"m_newDoubleValue":0.0,"m_newIntValue":0,"m_newStringValue":"{lv\u003dundone tasks[0]}","m_trueLabel":"True","m_userPrompt":false,"m_userPromptEmptyAtStart":false,"m_userPromptPassword":false,"m_userPromptPasswordToggle":false,"m_userPromptShowCancel":true,"m_userPromptStopAfterCancel":true,"m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":true,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"current task","m_stri